{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybersoc.invalid/ingestion/v1/snapshot.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "source": {
      "enum": [
        "mitre_attack",
        "cve",
        "cwe",
        "soc_log"
      ]
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048
    },
    "upstream_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "acquired_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "license_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "notice_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "notice_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "usage_scope": {
      "const": "project-retrieval"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": [
    "schema_version",
    "source",
    "source_url",
    "upstream_version",
    "acquired_at",
    "sha256",
    "artifact_ref",
    "license_ref",
    "notice_ref",
    "notice_sha256",
    "usage_scope",
    "owner"
  ],
  "additionalProperties": false
}
