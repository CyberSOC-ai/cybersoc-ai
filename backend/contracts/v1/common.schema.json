{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybersoc.invalid/contracts/v1/common.schema.json",
  "title": "common",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z(?![\\s\\S])"
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "validation_error",
            "unsupported_version",
            "conflict",
            "dependency_unavailable",
            "timeout",
            "invalid_output",
            "permission_denied",
            "audit_unavailable"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "ip",
            "host",
            "user",
            "domain",
            "hash",
            "file",
            "process"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "ip"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "anyOf": [
                  {
                    "format": "ipv4"
                  },
                  {
                    "format": "ipv6"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "domain"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "format": "hostname"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "hash"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^(?:[0-9a-fA-F]{32}|[0-9a-fA-F]{40}|[0-9a-fA-F]{64})(?![\\s\\S])"
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "source": {
          "enum": [
            "mitre_attack",
            "cve",
            "cwe",
            "threat_intel",
            "soc_log",
            "graph",
            "detection_rule",
            "playbook"
          ]
        },
        "source_record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "snapshot_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "score": {
          "type": [
            "number",
            "null"
          ]
        },
        "score_kind": {
          "enum": [
            "cosine",
            "distance",
            "rank",
            "rrf",
            "none"
          ]
        },
        "retrieval_method": {
          "enum": [
            "vector",
            "graph",
            "ioc",
            "hybrid"
          ]
        }
      },
      "required": [
        "evidence_id",
        "source",
        "source_record_id",
        "snapshot_ref",
        "content",
        "score",
        "score_kind",
        "retrieval_method"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "score_kind": {
                "const": "none"
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "score": {
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "severity": {
      "enum": [
        "informational",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "mode": {
      "enum": [
        "no_rag",
        "vector",
        "graph",
        "hybrid"
      ]
    },
    "versions": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "dataset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "configuration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
        }
      },
      "required": [
        "model",
        "prompt",
        "dataset",
        "configuration",
        "commit"
      ],
      "additionalProperties": false
    }
  }
}
