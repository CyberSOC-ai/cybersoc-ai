{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybersoc.invalid/contracts/v1/retrieval-response.schema.json",
  "title": "retrieval-response",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "trace_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "status": {
      "enum": [
        "ok",
        "error"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/evidence"
      },
      "maxItems": 100
    },
    "error": {
      "$ref": "common.schema.json#/$defs/error"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "trace_id",
    "status",
    "evidence"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        }
      },
      "then": {
        "required": [
          "error"
        ],
        "properties": {
          "evidence": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "error"
          ]
        }
      }
    }
  ]
}
