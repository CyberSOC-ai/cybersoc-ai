{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybersoc.invalid/contracts/v1/response-action.schema.json",
  "title": "response-action",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "action_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "incident_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "action_type": {
      "const": "block_ip"
    },
    "target": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "target_inventory_revision": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "environment_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "arguments": {
      "type": "object",
      "properties": {
        "source_ip": {
          "type": "string",
          "format": "ipv4"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "protocol": {
          "enum": [
            "tcp",
            "udp"
          ]
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      },
      "required": [
        "source_ip",
        "port",
        "protocol",
        "duration_seconds"
      ],
      "additionalProperties": false
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "expected_effect": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "risks": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "rollback_plan": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "requires_approval": {
      "const": true
    },
    "idempotency_key": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "status": {
      "enum": [
        "proposed",
        "approved",
        "rejected",
        "expired",
        "revoked",
        "executing",
        "succeeded",
        "failed",
        "unknown"
      ]
    },
    "approval": {
      "type": "object",
      "properties": {
        "approval_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "actor_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "decision": {
          "enum": [
            "approve",
            "reject"
          ]
        },
        "decided_at": {
          "$ref": "common.schema.json#/$defs/utc"
        },
        "expires_at": {
          "$ref": "common.schema.json#/$defs/utc"
        },
        "proposal_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "audit_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "approval_id",
        "actor_id",
        "decision",
        "decided_at",
        "expires_at",
        "proposal_digest",
        "audit_ref"
      ],
      "additionalProperties": false
    },
    "execution_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "error": {
      "$ref": "common.schema.json#/$defs/error"
    }
  },
  "required": [
    "schema_version",
    "action_id",
    "incident_id",
    "revision",
    "action_type",
    "target",
    "target_inventory_revision",
    "environment_id",
    "policy_version",
    "arguments",
    "reason",
    "expected_effect",
    "risks",
    "rollback_plan",
    "requires_approval",
    "idempotency_key",
    "status"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "approved",
              "executing",
              "succeeded",
              "failed",
              "unknown"
            ]
          }
        }
      },
      "then": {
        "required": [
          "approval"
        ],
        "properties": {
          "approval": {
            "properties": {
              "decision": {
                "const": "approve"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "rejected"
          }
        }
      },
      "then": {
        "required": [
          "approval"
        ],
        "properties": {
          "approval": {
            "properties": {
              "decision": {
                "const": "reject"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "proposed"
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "approval"
              ]
            },
            {
              "required": [
                "execution_ref"
              ]
            },
            {
              "required": [
                "error"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "executing",
              "succeeded",
              "failed",
              "unknown"
            ]
          }
        }
      },
      "then": {
        "required": [
          "execution_ref"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "failed",
              "unknown"
            ]
          }
        }
      },
      "then": {
        "required": [
          "error"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "proposed",
              "approved",
              "rejected",
              "expired",
              "revoked"
            ]
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "execution_ref"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "proposed",
              "approved",
              "rejected",
              "expired",
              "revoked",
              "executing",
              "succeeded"
            ]
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "error"
          ]
        }
      }
    }
  ]
}
