{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybersoc.invalid/contracts/v1/incident.schema.json",
  "title": "incident",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "incident_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "timestamp": {
      "$ref": "common.schema.json#/$defs/utc"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_event_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "severity": {
      "$ref": "common.schema.json#/$defs/severity"
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/entity"
      },
      "maxItems": 100
    },
    "raw_event_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "ingestion_kind": {
      "enum": [
        "live",
        "replay",
        "synthetic"
      ]
    }
  },
  "required": [
    "schema_version",
    "incident_id",
    "timestamp",
    "source",
    "source_event_id",
    "description",
    "severity",
    "entities",
    "ingestion_kind"
  ],
  "additionalProperties": false
}
